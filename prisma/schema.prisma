// ============================================================
// Club Machtia — Esquema de base de datos (PostgreSQL / Aiven)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
  PROFESOR_FACILITADOR
  SOCIO
  USUARIO
  ASISTENTE_ADMINISTRATIVO
}

enum Suscripcion {
  BASICA
  PLUS
  NEGOCIOS
  NINOS
  SOCIO_FUNDADOR
  ASOCIADO
  CREADOR_DE_CURSOS
}

enum EstadoCuenta {
  PENDIENTE_CONFIRMACION // preregistro, esperando confirmar correo
  PENDIENTE_APROBACION // ya completó el registro, falta revisar comprobante de pago
  ACTIVA
  INACTIVA // no renovó, conserva posición hasta 2 años
  RECHAZADA
}

enum Lado {
  IZQUIERDA
  DERECHA
}

enum EstadoSlot {
  VACIO
  INVITADO
  OCUPADO
}

model User {
  id              String       @id @default(cuid())
  nombre          String
  apellido        String
  nombreUsuario   String?      @unique
  correo          String       @unique
  correoRespaldo  String?
  telefono        String?
  ladaPais        String?
  pais            String?
  estadoProvincia String?
  ciudad          String?

  fotoPerfilUrl      String?
  direccionCalle     String?
  direccionColonia   String?
  codigoPostal       String?
  textoPresentacion  String?
  redSocialFacebook  String?
  redSocialInstagram String?
  redSocialTiktok    String?
  membresiaExpiraEn  DateTime?

  rol           Rol          @default(USUARIO)
  suscripcion   Suscripcion?
  status        EstadoCuenta @default(PENDIENTE_CONFIRMACION)

  passwordHash        String?
  comprobantePagoUrl  String?
  tokenConfirmacion   String?  @unique
  correoConfirmado    Boolean  @default(false)

  linkInvitacion String @unique @default(cuid())

  // Quién lo invitó originalmente (para la regla de "enviar al fondo")
  invitadoPorId String?
  invitadoPor   User?   @relation("Invitaciones", fields: [invitadoPorId], references: [id])
  invitados     User[]  @relation("Invitaciones")

  // Posición dentro del árbol binario de la red (fuera de los 8 niveles restringidos)
  padreRedId  String?
  padreRed    User?    @relation("ArbolRed", fields: [padreRedId], references: [id])
  hijosRed    User[]   @relation("ArbolRed")
  ladoEnPadre Lado?

  // Posición dentro del árbol de la Red Alterna (Campaña de Lanzamiento):
  // mismo mecanismo que padreRedId/hijosRed/ladoEnPadre, pero con 8
  // posiciones por nivel en vez de 2 (confirmado por el cliente el
  // 18 sept 2026 — ver comentario al inicio de src/lib/redAlterna.ts).
  // Cada usuario se inserta por BFS dentro del árbol de quien lo
  // invitó (invitadoPorId), igual que en la Red de Usuarios.
  padreAlternaId         String?
  padreAlterna           User?   @relation("ArbolAlterna", fields: [padreAlternaId], references: [id])
  hijosAlterna           User[]  @relation("ArbolAlterna")
  posicionEnPadreAlterna Int? // 1 a 8

  slotRestringido SlotRestringido?

  // Red Alterna — regalías que este usuario generó y las que ganó
  regaliasOrigen      RegaliaRedAlterna[] @relation("RegaliasOrigen")
  regaliasGanadas     RegaliaRedAlterna[] @relation("RegaliasGanadas")

  // Notificaciones personales (invitado directo nuevo, alguien se
  // unió a su Red 2x15) — ver NotificacionUsuario más abajo.
  notificacionesRecibidas NotificacionUsuario[]
  notificacionesOcultas   NotificacionOculta[]

  // Cursos/Talleres — Elemento 4 (26 sept 2026)
  inscripcionesCursos InscripcionCurso[]

  // true si un Administrador la eliminó definitivamente de la Red de
  // Usuarios ("Eliminar definitivo + comprimir"). Conserva la cuenta
  // y su historial, pero deja de contar como participante activo de
  // la red — se usa para que ya no aparezca en la lista de Usuarios.
  fueraDeRed Boolean @default(false)

  // true = esta fila es un espacio "reservado" de la Red General
  // (niveles 1-8) que todavía nadie reclamó — existe únicamente para
  // que la posición ya esté conectada al árbol desde el día uno (idea
  // confirmada por el cliente el 16 sept 2026). Cuando alguien se
  // registra en ese espacio, esta MISMA fila se actualiza con sus
  // datos reales y reservado pasa a false — nunca se crea una fila
  // nueva ni se mueve de posición. Ver prisma/backfill-red-general.mjs.
  reservado Boolean @default(false)

  // Última vez que este usuario abrió el panel de notificaciones (🔔
  // del Dashboard) — se usa para saber si hay notificaciones nuevas
  // sin leer. null = nunca lo ha abierto (todo cuenta como sin leer).
  ultimaNotificacionVistaEn DateTime?

  inactivoDesde DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@index([invitadoPorId])
  @@index([padreRedId])
  @@index([padreAlternaId])
  @@unique([padreRedId, ladoEnPadre])
  @@unique([padreAlternaId, posicionEnPadreAlterna])
}

// Los primeros 8 niveles de la Red General: existen como espacios fijos
// que solo el Administrador llena generando una invitación específica.
model SlotRestringido {
  id         String     @id @default(cuid())
  nivel      Int
  posicion   Int
  status     EstadoSlot @default(VACIO)
  inviteLink String?    @unique

  usuarioId String? @unique
  usuario   User?   @relation(fields: [usuarioId], references: [id])
  preregistros Preregistro[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([nivel, posicion])
}

// ============================================================
// Anuncios y avisos — panel "Anuncios y avisos" del Dashboard.
// Editable por Administrador y Asistente Administrativo desde
// Panel de Administrador → Anuncios.
// ============================================================
model Anuncio {
  id       String  @id @default(cuid())
  etiqueta String // ej. "Lanzamiento", "Cursos", "Plataforma"
  texto    String

  // Imagen o video corto opcional (pedido por el cliente el 20 sept
  // 2026). Se sube a Vercel Blob desde el Panel de Administrador →
  // Anuncios — ver src/app/api/admin/anuncios/media/route.ts para las
  // medidas/duración máximas aplicadas.
  mediaUrl  String?
  mediaTipo MediaTipo?

  // Si está en false, deja de mostrarse en el Dashboard de los
  // usuarios pero se conserva (no se borra) para poder reactivarlo.
  activo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([activo, creadoEn])
}

enum MediaTipo {
  IMAGEN
  VIDEO
}

// ============================================================
// Publicidad — sección nueva pedida por el cliente el 25 sept 2026,
// paralela a Anuncios: un carrusel de hasta 8 imágenes en formato
// publicación de Facebook, listas para que cualquier usuario las
// descargue y las use para promocionar el negocio en sus redes.
// Editable desde Panel de Administrador → Publicidad.
// ============================================================
model PublicidadImagen {
  id        String @id @default(cuid())
  imagenUrl String

  // Posición dentro del carrusel (0 = primera). Se usa para poder
  // reordenar sin depender de la fecha de creación.
  orden Int @default(0)

  // Si está en false, deja de mostrarse/descargarse a los usuarios
  // pero se conserva (no se borra) para poder reactivarla.
  activo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([activo, orden])
}

// ============================================================
// Notificaciones directas — botón 🔔 del Dashboard. Distintas de los
// Anuncios: son mensajes cortos que el Administrador emite para
// avisar algo puntual a todos los usuarios (pedido por el cliente el
// 20 sept 2026, "Crear notificación" dentro de Panel de
// Administrador → Anuncios).
// ============================================================
model Notificacion {
  id      String @id @default(cuid())
  mensaje String

  creadoEn DateTime @default(now())

  ocultaPara NotificacionOculta[]

  @@index([creadoEn])
}

// Notificaciones personales, distintas de Notificacion (que es un
// aviso general del Administrador para todos): estas se generan solo
// para UN usuario en particular, automáticamente, cuando (pedido por
// el cliente el 20 sept 2026):
//   1. Alguien se registra con su link de invitación personal
//      (invitadoPorId) — se le notifica a él.
//   2. Alguien se une a su Red 2x15 (padreRedId, la posición exacta
//      del árbol) — se le notifica a él.
// Se generan en el momento de aprobar la solicitud, que es cuando
// ambas cosas ya son reales (ver /api/admin/aprobar).
model NotificacionUsuario {
  id             String  @id @default(cuid())
  destinatarioId String
  destinatario   User    @relation(fields: [destinatarioId], references: [id])
  mensaje        String
  leida          Boolean @default(false)

  creadoEn DateTime @default(now())

  @@index([destinatarioId, creadoEn])
}

// Un usuario puede "borrar" un aviso GENERAL del Administrador
// (Notificacion) desde su campanita — pedido por el cliente el 25
// sept 2026. Como ese aviso es compartido por todos, no se borra la
// fila real (le seguiría apareciendo a los demás); en vez de eso se
// guarda que ESTE usuario ya lo ocultó, y se filtra al armar su
// lista en /api/notificaciones. Las notificaciones personales
// (NotificacionUsuario) sí se borran de verdad — son de un solo
// destinatario, ver /api/notificaciones/[id].
model NotificacionOculta {
  id             String       @id @default(cuid())
  usuarioId      String
  usuario        User         @relation(fields: [usuarioId], references: [id])
  notificacionId String
  notificacion   Notificacion @relation(fields: [notificacionId], references: [id])

  ocultaEn DateTime @default(now())

  @@unique([usuarioId, notificacionId])
}

// Preregistro (Fase 1): antes de que exista una cuenta real de User.
model Preregistro {
  id                String   @id @default(cuid())
  nombre            String
  correo            String
  invitadorSlug     String?
  slotRestringidoId String?
  slotRestringido   SlotRestringido? @relation(fields: [slotRestringidoId], references: [id])
  tokenConfirmacion String   @unique
  confirmado        Boolean  @default(false)
  creadoEn          DateTime @default(now())
}

// ============================================================
// Red Alterna — Campaña de Lanzamiento
// ------------------------------------------------------------
// Registro contable de cada regalía generada. Se calcula al
// momento en que un usuario activa una suscripción de pago,
// caminando hasta 5 niveles hacia arriba en la cadena real de
// invitaciones (invitadoPorId), mientras la fecha de corte de
// la campaña no se haya cumplido. Ver src/lib/redAlterna.ts.
// ============================================================
model RegaliaRedAlterna {
  id             String      @id @default(cuid())

  // Quién recibe el dinero (el patrocinador, en algún nivel arriba)
  beneficiarioId String
  beneficiario   User        @relation("RegaliasGanadas", fields: [beneficiarioId], references: [id])

  // Quién activó la suscripción que generó esta regalía
  origenId       String
  origen         User        @relation("RegaliasOrigen", fields: [origenId], references: [id])

  nivel          Int         // 1 a 5 (distancia en la cadena de invitación)
  monto          Decimal     @db.Decimal(10, 2)
  tablaAplicada  Suscripcion // BASICA | PLUS | NEGOCIOS — cuál tabla se usó para calcular el monto

  // true = NO es una regalía real por invitación: es el pago de nivel 1
  // simulado para personas en posiciones restringidas sin invitados
  // propios (pedido del cliente el 2 oct 2026, para que puedan sumar
  // durante la Red Alterna sin necesidad de invitar). En estos casos
  // beneficiarioId === origenId (se paga a sí mismo, no hay invitado real).
  simulada       Boolean     @default(false)

  creadoEn       DateTime    @default(now())

  @@index([beneficiarioId])
  @@index([origenId])
}

// ============================================================
// Cursos y Talleres — "Elemento 4", pedido por el cliente el 26
// sept 2026: interfaz y estructura completa (buscador, banner,
// "sigue aprendiendo", filtros, carruseles, calendario de eventos,
// instructores, rutas de aprendizaje) + reproducción/avance/
// evaluación por lección + seguimiento básico de progreso.
//
// Alcance de esta primera entrega (documentado también en las
// notas del proyecto): la analítica avanzada, la comunidad/foro y
// el panel completo de gestión para Profesores Facilitadores
// quedan para una siguiente ronda — son, en sí mismos, proyectos
// grandes aparte.
// ============================================================

enum TipoCurso {
  CURSO
  TALLER
}

enum NivelDificultad {
  BASICO
  INTERMEDIO
  AVANZADO
}

enum CategoriaCurso {
  NEGOCIOS
  FINANZAS
  MARKETING
  SALUD
  IDIOMAS
  HABILIDADES_DIGITALES
}

enum TipoLeccion {
  VIDEO
  LECTURA
}

model Instructor {
  id           String  @id @default(cuid())
  nombre       String
  especialidad String
  fotoUrl      String?

  cursos Curso[]

  creadoEn DateTime @default(now())

  @@index([nombre])
}

model RutaAprendizaje {
  id          String  @id @default(cuid())
  titulo      String
  descripcion String
  nivel       NivelDificultad @default(BASICO)
  color       String  @default("#2E3192") // acento visual de la tarjeta de la ruta

  cursos Curso[]

  creadoEn DateTime @default(now())
}

model Curso {
  id                String          @id @default(cuid())
  tipo              TipoCurso       @default(CURSO)
  titulo            String
  descripcionBreve  String
  descripcionLarga  String?
  portadaUrl        String?
  categoria         CategoriaCurso
  nivel             NivelDificultad @default(BASICO)

  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id])

  rutaAprendizajeId String?
  rutaAprendizaje   RutaAprendizaje? @relation(fields: [rutaAprendizajeId], references: [id])
  ordenEnRuta       Int?

  duracionMinutos Int @default(0)

  calificacionPromedio Float @default(0)
  numCalificaciones    Int   @default(0)

  // Banderas que alimentan los carruseles pedidos ("Nuevos en
  // Machtia", "Clases cortas para hoy", "Cursos especiales") — se
  // marcan a mano desde el Panel de Administrador, no se calculan
  // solas, para que el equipo de contenido decida qué destacar.
  esNuevo    Boolean @default(false)
  esEspecial Boolean @default(false)
  esCorto    Boolean @default(false)

  activo Boolean @default(true)

  lecciones     Leccion[]
  inscripciones InscripcionCurso[]
  eventos       EventoCurso[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([tipo, activo])
  @@index([categoria])
  @@index([esNuevo])
  @@index([esEspecial])
  @@index([esCorto])
}

model Leccion {
  id     String      @id @default(cuid())
  cursoId String
  curso   Curso       @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  titulo          String
  orden           Int
  tipoContenido   TipoLeccion
  contenidoUrl    String? // video
  contenidoTexto  String? // lectura
  duracionMinutos Int     @default(5)

  completadas LeccionCompletada[]

  @@unique([cursoId, orden])
}

// Progreso de UN usuario en UN curso — pedido por el cliente el 26
// sept 2026 ("sigue aprendiendo" con % de avance, seguimiento).
model InscripcionCurso {
  id     String @id @default(cuid())
  cursoId String
  curso   Curso  @relation(fields: [cursoId], references: [id])
  usuarioId String
  usuario   User @relation(fields: [usuarioId], references: [id])

  progreso   Float   @default(0) // 0 a 100
  completado Boolean @default(false)

  // Nota de la evaluación simple al terminar el curso (ver
  // src/lib/cursos.ts) — null hasta que la presente.
  calificacionEvaluacion Int?

  leccionesCompletadas LeccionCompletada[]

  inscritoEn      DateTime @default(now())
  ultimaActividad DateTime @updatedAt

  @@unique([usuarioId, cursoId])
  @@index([usuarioId])
}

model LeccionCompletada {
  id             String            @id @default(cuid())
  inscripcionId  String
  inscripcion    InscripcionCurso  @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  leccionId      String
  leccion        Leccion           @relation(fields: [leccionId], references: [id], onDelete: Cascade)

  completadaEn DateTime @default(now())

  @@unique([inscripcionId, leccionId])
}

// Calendario de "próximos eventos relacionados a los cursos"
// pedido por el cliente el 26 sept 2026.
model EventoCurso {
  id                String   @id @default(cuid())
  titulo            String
  instructorNombre  String
  fechaHora         DateTime
  linkAcceso        String?

  cursoId String?
  curso   Curso?  @relation(fields: [cursoId], references: [id])

  creadoEn DateTime @default(now())

  @@index([fechaHora])
}

